FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY Book.sln ./
COPY src/backend/Book.Api/Book.Api.csproj src/backend/Book.Api/
COPY src/backend/Book.Application/Book.Application.csproj src/backend/Book.Application/
COPY src/backend/Book.Domain/Book.Domain.csproj src/backend/Book.Domain/
COPY src/backend/Book.Infrastructure/Book.Infrastructure.csproj src/backend/Book.Infrastructure/

RUN dotnet restore src/backend/Book.Api/Book.Api.csproj

COPY src/backend ./src/backend
RUN dotnet publish src/backend/Book.Api/Book.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

ENV ASPNETCORE_ENVIRONMENT=Development
ENV ASPNETCORE_HTTP_PORTS=8080

COPY --from=build /app/publish ./

EXPOSE 8080

ENTRYPOINT ["dotnet", "Book.Api.dll"]
