# Template de Dockerfile para a API .NET 8.
# Ajuste os caminhos apos criar os projetos reais em src/backend/.

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY . .
RUN test -f src/backend/Book.Api/Book.Api.csproj
RUN dotnet restore src/backend/Book.Api/Book.Api.csproj
RUN dotnet publish src/backend/Book.Api/Book.Api.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Book.Api.dll"]
