# Template de Dockerfile para o frontend React.
# Ajuste os caminhos apos criar o projeto real em src/frontend-react/.

FROM node:20-alpine AS build
WORKDIR /app

COPY . .
RUN test -f src/frontend-react/book-insights/package.json
WORKDIR /app/src/frontend-react/book-insights
RUN npm install
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/src/frontend-react/book-insights/dist /usr/share/nginx/html
EXPOSE 80
