# Template de Dockerfile para o frontend Angular.
# Ajuste os caminhos apos criar o projeto real em src/frontend-angular/.

FROM node:20-alpine AS build
WORKDIR /app

COPY . .
RUN test -f src/frontend-angular/book-admin/package.json
WORKDIR /app/src/frontend-angular/book-admin
RUN npm install
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/src/frontend-angular/book-admin/dist /usr/share/nginx/html
EXPOSE 80
